   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Two boxes: the GATEWAY decides what enters and where; the ENGINE decides what runs next.  Everything runs on one Lambda GPU host.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Two boxes: the GATEWAY decides what enters and where; the ENGINE decides what runs next.  Everything runs on one Lambda GPU host.",
   "lineHeight": 1.25,
   "autoResize": true
  },
