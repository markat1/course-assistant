   "updated": 1,
   "link": null,
   "locked": false,
   "text": "PROVEN ON THE GPU (A100 80GB, 30 Sep)\n76 x 429 only on tenant revision-batch\ninteractive + agent: 0 failures; batch -> 504\nhops: 2 in a 3-min mix (was 399, over-counted)\nkill worker: 1,200/1,200 OK, 19 s ramp delay\nclient leaves: engine running 1 -> 0\nalerts fired: TtftSloBreach, HighShedRate",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "el777129422",
   "originalText": "PROVEN ON THE GPU (A100 80GB, 30 Sep)\n76 x 429 only on tenant revision-batch\ninteractive + agent: 0 failures; batch -> 504\nhops: 2 in a 3-min mix (was 399, over-counted)\nkill worker: 1,200/1,200 OK, 19 s ramp delay\nclient leaves: engine running 1 -> 0\nalerts fired: TtftSloBreach, HighShedRate",
   "lineHeight": 1.25,
   "autoResize": true
  },
