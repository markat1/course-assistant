  {
   "id": "el811326932",
   "type": "text",
   "x": 1437,
   "y": 402,
   "width": 166,
   "height": 402.5,
   "angle": 0,
   "strokeColor": "#0c8599",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1806584668,
   "version": 1,
   "versionNonce": 561623934,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "HOP\nbackend:\nrecompute\n(no Mooncake,\nno NIXL)\n\nsrc == dst:\nno hop\n\nsrc != dst:\nrecord src, dst,\nprefix, tokens\n\nNOTHING copied:\ndst recomputes\nthe prefix\n\nworker lost ->\nforget_worker\n= no ghosts\n\nkv_a | kv_b |\nkv_both",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "el165395729",
   "originalText": "HOP\nbackend:\nrecompute\n(no Mooncake,\nno NIXL)\n\nsrc == dst:\nno hop\n\nsrc != dst:\nrecord src, dst,\nprefix, tokens\n\nNOTHING copied:\ndst recomputes\nthe prefix\n\nworker lost ->\nforget_worker\n= no ghosts\n\nkv_a | kv_b |\nkv_both",
   "lineHeight": 1.25,
   "autoResize": true
  },
