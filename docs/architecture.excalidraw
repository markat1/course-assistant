   "updated": 1,
   "link": null,
   "locked": false,
   "text": "STATUS CODES (who refuses, and stay or leave)\n400  guard: bad_max_tokens, prompt_too_long\n429  tenant_tokens (+Retry-After)        STAY\n503  no_eligible_workers, kv_pressure,\n     queue_full (+Retry-After 7)     MAY LEAVE\n504  timeout_queue (waited > 5 s)        STAY\n502/504 upstream error / timeout",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "el197402358",
   "originalText": "STATUS CODES (who refuses, and stay or leave)\n400  guard: bad_max_tokens, prompt_too_long\n429  tenant_tokens (+Retry-After)        STAY\n503  no_eligible_workers, kv_pressure,\n     queue_full (+Retry-After 7)     MAY LEAVE\n504  timeout_queue (waited > 5 s)        STAY\n502/504 upstream error / timeout",
   "lineHeight": 1.25,
   "autoResize": true
  },
