      "version": 1,
      "versionNonce": 714307834,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "WHY 8 KV HEADS MATTER  (GQA)\nSeveral attention heads share one K and V.\n\nSame model without GQA: 32 KV heads\n= 4x = 576 KiB per token\n= 3.5 full-length sequences per slice\ninstead of 14.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WHY 8 KV HEADS MATTER  (GQA)\nSeveral attention heads share one K and V.\n\nSame model without GQA: 32 KV heads\n= 4x = 576 KiB per token\n= 3.5 full-length sequences per slice\ninstead of 14.",
      "lineHeight": 1.25,
      "autoResize": true
    }
