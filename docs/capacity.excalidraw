      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Conservative: the prefix cache stores the shared prefix\nonce per worker, not once per sequence.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Conservative: the prefix cache stores the shared prefix\nonce per worker, not once per sequence.",
      "lineHeight": 1.25,
      "autoResize": true
    },
