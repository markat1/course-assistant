    },
    {
      "id": "el627092439",
      "type": "text",
      "x": 870,
      "y": 562,
      "width": 563.9,
      "height": 52.5,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
