      "roundness": null,
      "seed": 214278804,
      "version": 1,
      "versionNonce": 235542814,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "One Service per pod (worker-a, worker-b), so the gateway can\nsend a request to a specific worker. k3s' own ingress and\nload balancer are disabled: the gateway does the routing.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "One Service per pod (worker-a, worker-b), so the gateway can\nsend a request to a specific worker. k3s' own ingress and\nload balancer are disabled: the gateway does the routing.",
      "lineHeight": 1.25,
      "autoResize": true
    },
