      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Kubernetes (k3s) runs the two engines because only it can slice the GPU with HAMi.  Docker Compose runs everything we wrote.",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Kubernetes (k3s) runs the two engines because only it can slice the GPU with HAMi.  Docker Compose runs everything we wrote.",
      "lineHeight": 1.25,
      "autoResize": true
    },
