GATEWAY_MODEL_NAME=Qwen/Qwen3-8B
GATEWAY_WORKER_URLS='{"worker-a":"http://worker-a:8000/v1","worker-b":"http://worker-b:8000/v1"}'
GATEWAY_UPSTREAM_TIMEOUT_S=20
GATEWAY_METRICS_INTERVAL_S=5
GATEWAY_METRICS_MAX_AGE_S=10
GATEWAY_KV_USAGE_LIMIT=0.90
GATEWAY_QUEUE_MAX_SIZE=16
GATEWAY_QUEUE_TIMEOUT_S=5
# estimate (characters / 4) or tokenizer (Qwen tokenizer, fetched at startup)
GATEWAY_TOKEN_COUNTER=tokenizer
